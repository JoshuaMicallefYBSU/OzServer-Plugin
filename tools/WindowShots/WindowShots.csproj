<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Renders the plugin's own windows to PNG without connecting to anything, for the website's
      screenshots. It compiles the plugin's source beside a small host (Program.cs) that loads the
      vatSys profile, colours and fonts the windows are drawn with, fills them with example data,
      and saves what is on screen.

      Two plugin files are left out and replaced (Stubs.cs): the API address, so nothing here can
      reach OzServer, and the log, so nothing is written to the controller's real log file.

        dotnet build tools\WindowShots -c Release
        tools\WindowShots\bin\WindowShots.exe <output folder>
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net472</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <PlatformTarget>x86</PlatformTarget>
        <AssemblyName>WindowShots</AssemblyName>
        <RootNamespace>OzServerPlugin</RootNamespace>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <OutputPath>bin\</OutputPath>
        <!-- The plugin's own version, which its windows print in their titles. -->
        <Version>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\OzServerPlugin\OzServerPlugin.csproj')), '&lt;Version&gt;([0-9][0-9.]*)&lt;').Groups.get_Item(1).Value)</Version>
        <VatSysPath Condition="'$(VatSysPath)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Sawbe\vatSys@Path)</VatSysPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\OzServerPlugin\**\*.cs"
                 Exclude="..\..\OzServerPlugin\obj\**;..\..\OzServerPlugin\bin\**;..\..\OzServerPlugin\Secrets.cs;..\..\OzServerPlugin\OzServerSettings.cs;..\..\OzServerPlugin\ActionLog.cs"
                 LinkBase="Plugin" />
        <Reference Include="vatSys"><HintPath>$(VatSysPath)\bin\vatSys.exe</HintPath><Private>False</Private></Reference>
        <Reference Include="VATSYSControls"><HintPath>$(VatSysPath)\bin\VATSYSControls.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="Newtonsoft.Json"><HintPath>$(VatSysPath)\bin\Newtonsoft.Json.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="RossCarlson.Vatsim.Network"><HintPath>$(VatSysPath)\bin\RossCarlson.Vatsim.Network.dll</HintPath><Private>False</Private></Reference>
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
        <Reference Include="System.ComponentModel.Composition" />
        <Reference Include="System.Configuration" />
        <Reference Include="System.Drawing" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

</Project>
