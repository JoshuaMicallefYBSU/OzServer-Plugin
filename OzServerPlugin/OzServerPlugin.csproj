<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- vatSys.exe is x86, and the plugin loads into its process. -->
        <PlatformTarget>x86</PlatformTarget>

        <AssemblyName>OzServerPlugin</AssemblyName>
        <RootNamespace>OzServerPlugin</RootNamespace>
        <Version>0.2.6</Version>
    </PropertyGroup>

    <PropertyGroup>
        <VatSysPath Condition="'$(VatSysPath)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Sawbe\vatSys@Path)</VatSysPath>
        <!--
          vatSys scans the profile's Plugins folder, so the output must be a flat folder holding
          one OzServerPlugin.dll. The default bin\Debug\net472\ nesting would leave a second copy
          under the same plugin root; MEF then sees two IPlugin types and silently fails to load
          the plugin. To build straight into a vatSys profile, set OutputPath in
          OzServerPlugin.csproj.user (per-developer, gitignored) or on the command line:
            dotnet build -p:OutputPath="C:\...\Profiles\Australia\Plugins\OzServerPlugin\"
        -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!--
      Fails early with a clear message when vatSys cannot be found, rather than with a wall of
      "the type or namespace 'vatsys' could not be found" errors. For a non-default install
      location, build with -p:VatSysPath="D:\vatSys".
    -->
    <Target Name="EnsureVatSysPath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="'$(VatSysPath)' == ''" Text="Could not locate vatSys. It is normally found via HKLM\SOFTWARE\WOW6432Node\Sawbe\vatSys@Path, which is unset or unreadable here - install vatSys, or build with -p:VatSysPath=&quot;C:\Path\To\vatSys&quot;." />
        <Error Condition="'$(VatSysPath)' != '' AND !Exists('$(VatSysPath)\bin\vatSys.exe')" Text="VatSysPath is '$(VatSysPath)' but '$(VatSysPath)\bin\vatSys.exe' does not exist. Point VatSysPath at the vatSys install root (the folder containing bin\vatSys.exe)." />
    </Target>

    <ItemGroup>
        <!-- Secrets.cs belonged to early token-authenticated builds and is not compiled. -->
        <Compile Remove="Secrets.cs" />
        <!--
          Compiled against the installed vatSys.exe for the real vatsys/vatsys.Plugin types.
          Private=False keeps it out of the output folder: with a second copy beside the plugin
          DLL, MEF sees two distinct IPlugin types and silently fails to load the plugin.
        -->
        <Reference Include="vatSys">
            <HintPath>$(VatSysPath)\bin\vatSys.exe</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
          vatSys's own control library (TreeViewEx, GenericButton, ...), so the plugin's windows
          use the same control types as vatSys's. Private=False as above.
        -->
        <Reference Include="VATSYSControls">
            <HintPath>$(VatSysPath)\bin\VATSYSControls.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
          The copy of Newtonsoft.Json vatSys already loads, rather than one from NuGet.
          Private=False avoids shipping a second, possibly different, version into the process.
        -->
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(VatSysPath)\bin\Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
          Supplies the NetworkRating/NetworkFacility enums that Network.Rating and
          Network.Facility are typed with (see NetworkIdentity.IsObserver). Private=False as above.
        -->
        <Reference Include="RossCarlson.Vatsim.Network">
            <HintPath>$(VatSysPath)\bin\RossCarlson.Vatsim.Network.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!-- ZipFile/ExtractToFile, for release assets published as a zip rather than a bare DLL. -->
        <Reference Include="System.IO.Compression" />
        <Reference Include="System.IO.Compression.FileSystem" />
        <Reference Include="System.ComponentModel.Composition" />
        <Reference Include="System.Drawing" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

</Project>
