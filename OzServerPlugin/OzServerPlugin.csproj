<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- vatSys.exe itself is built x86; match it so the plugin loads into the same process without an architecture mismatch. -->
        <PlatformTarget>x86</PlatformTarget>

        <AssemblyName>OzServerPlugin</AssemblyName>
        <RootNamespace>OzServerPlugin</RootNamespace>
        <Version>0.1.3</Version>
    </PropertyGroup>

    <PropertyGroup>
        <VatSysPath Condition="'$(VatSysPath)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Sawbe\vatSys@Path)</VatSysPath>
        <!--
          vatSys discovers plugins by scanning the profile's Plugins folder, so the build output
          needs to be a flat folder holding exactly one OzServerPlugin.dll - the same shape every
          other installed plugin uses. The default bin\Debug\net472\ nesting would leave a second
          copy of the assembly under the same plugin root, and MEF then sees two distinct IPlugin
          types and silently fails to load the plugin (the same trap the Private=False notes below
          guard against). To build straight into a vatSys profile rather than bin\, set OutputPath
          in OzServerPlugin.csproj.user - per-developer and gitignored, so this shared project file
          keeps no one machine's paths - or pass it on the command line:
            dotnet build -p:OutputPath="C:\...\Profiles\Australia\Plugins\OzServerPlugin\"
        -->
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!--
      Without this, a machine that simply doesn't have vatSys installed gets an empty VatSysPath,
      every HintPath below resolves to a bare "\bin\vatSys.exe", and the build fails with a wall of
      "the type or namespace 'vatsys' could not be found" errors that say nothing about the actual
      cause. Fail early and say what's wrong instead. Set VatSysPath explicitly (e.g.
      `dotnet build -p:VatSysPath="D:\vatSys"`) for a non-default install location.
    -->
    <Target Name="EnsureVatSysPath" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="'$(VatSysPath)' == ''" Text="Could not locate vatSys. It is normally found via HKLM\SOFTWARE\WOW6432Node\Sawbe\vatSys@Path, which is unset or unreadable here - install vatSys, or build with -p:VatSysPath=&quot;C:\Path\To\vatSys&quot;." />
        <Error Condition="'$(VatSysPath)' != '' AND !Exists('$(VatSysPath)\bin\vatSys.exe')" Text="VatSysPath is '$(VatSysPath)' but '$(VatSysPath)\bin\vatSys.exe' does not exist. Point VatSysPath at the vatSys install root (the folder containing bin\vatSys.exe)." />
    </Target>

    <ItemGroup>
        <!-- Exclude any ignored Secrets.cs left over from token-authenticated older builds so an
             obsolete shared credential cannot be embedded in a new assembly. -->
        <Compile Remove="Secrets.cs" />
        <!--
          Reference the installed vatSys.exe so the plugin compiles against the
          real vatsys/vatsys.Plugin types (BaseForm, Colours, MMI, IPlugin, etc).
          Private=False is required: vatSys.exe must NOT be copied into the
          plugin's output folder. If a second copy of vatSys.exe ships alongside
          the plugin DLL, MEF composition inside the running vatSys process will
          see two distinct IPlugin types (one per loaded copy of the assembly)
          and silently fail to load the plugin.
        -->
        <Reference Include="vatSys">
            <HintPath>$(VatSysPath)\bin\vatSys.exe</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
          Same reasoning as vatSys.exe above: reference vatSys's own copy of the
          control library (TreeViewEx, GenericButton, VATSYSControls.ScrollBar, ...)
          rather than bundling one, so the Sectors window is built from the exact
          same control types the real vatSys windows use.
        -->
        <Reference Include="VATSYSControls">
            <HintPath>$(VatSysPath)\bin\VATSYSControls.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <!--
          Reference the copy of Newtonsoft.Json vatSys itself already ships and loads
          (vatSys\bin\Newtonsoft.Json.dll), rather than bundling our own via NuGet.
          Private=False keeps our plugin from shipping a second, possibly different-version
          copy that could conflict with the one already resident in the process.
        -->
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(VatSysPath)\bin\Newtonsoft.Json.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="System.ComponentModel.Composition" />
        <Reference Include="System.Drawing" />
        <Reference Include="System.Net.Http" />
        <Reference Include="System.Windows.Forms" />
    </ItemGroup>

</Project>
