namespace OzServerPlugin;

// Template for Secrets.cs, which is gitignored (this repo is public, and the real value
// authenticates every plugin request against the live OzServer database - see the auth comment on
// OzServerApiClient). Copy this file to Secrets.cs and fill in the real token to build a working
// plugin locally; it must match PLUGIN_TOKEN in the OzServer backend's .env
// (config('services.plugin.token'), checked by app/Http/Middleware/VerifyPluginToken.php).
internal static class Secrets
{
    public const string PluginToken = "";
}
